  + total(): double
}

class ItemPedido {
  - nome: String
  - quantidade: int
  - precoUnitario: double
}

Pedido "1" *-- "1..*" ItemPedido : composição

note bottom of Pedido
  Losango PREENCHIDO em Pedido:
  o ItemPedido nasce e morre com o pedido
