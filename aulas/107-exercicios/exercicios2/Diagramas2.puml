note right of Pedido
  b) O item nasce DENTRO do pedido
  (new no método — composição):

  boolean adicionarItem(String nome,
                        int qtd,
                        double preco) {
    if (quantidade >= itens.length) {
      return false;
    }
    itens[quantidade] =
        new ItemPedido(nome, qtd, preco);
    quantidade++;
    return true;
  }
